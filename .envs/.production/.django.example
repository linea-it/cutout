# Copiar para .django no servidor e preencher secrets.
# production.yml carrega: ./.envs/.production/.django

# Sky Viewer (HiPS privados LSST) — mesmo valor de BASE_HOST no sky-viewer
# ------------------------------------------------------------------------------
SKYVIEWER_BASE_HOST=https://skyviewer.linea.org.br
# HiPS DP1 no mesmo origin do Cutout (montar o archive neste path)
# CUTOUT_HIPS_LSST_DP1_ROOT=/data/hips/lsst_dp1

