#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


YELLOW='\033[00;33m'
GREEN="\[\033[0;32m\]"
NO_COLOR='\033[0m'

echo "Running Migrate to apply changes in database"
python manage.py migrate

echo "Running Collect Statics"
python manage.py collectstatic --clear --noinput --verbosity 0

echo "${YELLOW}Running Django with Gunicorn.${NO_COLOR}"
GUNICORN_CMD="gunicorn config.wsgi:application \
    --bind 0.0.0.0:8000 \
    --workers ${GUNICORN_WORKERS:-2} \
    --threads ${GUNICORN_THREADS:-2} \
    --timeout 180"

# Adiciona --reload se GUNICORN_RELOAD for true/1/True
if [ "${GUNICORN_RELOAD}" = "1" ] || [ "${GUNICORN_RELOAD}" = "true" ] || [ "${GUNICORN_RELOAD}" = "True" ]; then
    GUNICORN_CMD="$GUNICORN_CMD --reload"
fi

echo "${YELLOW}Gunicorn Command: ${GUNICORN_CMD}${NO_COLOR}"

eval $GUNICORN_CMD
